# Neon Postgres connection string (Dashboard → Connection details → URI)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Better Auth (required in production / Vercel)
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Local: http://localhost:3000 | Production: https://elhigueron.xyz
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seed unique administrador (pnpm db:seed-admin)
ADMIN_EMAIL=admin@elhigueron.com
ADMIN_PASSWORD=Mbs2024
ADMIN_NAME=Administrador

# OpenAI (chatbot)
OPENAI_API_KEY=

# Cloudflare R2 (almacenamiento de imágenes estáticas del sitio: galería,
# boulder, camping, naturaleza, equipos, novedades). El contenido generado
# por visitantes (Muro) sigue en Cloudinary, ver NEXT_PUBLIC_CLOUDINARY_* más
# abajo — son dos almacenamientos distintos a propósito.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=elhigueron-media
# URL pública del bucket (dominio r2.dev habilitado o dominio propio conectado)
R2_PUBLIC_URL=https://media.elhigueron.xyz

# Cloudinary (subida de fotos/videos de publicaciones del Muro desde el navegador)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Contraseñas por defecto para el reseteo desde el panel de administración.
# Al resetear, el usuario DEBE cambiar la contraseña en su próximo inicio de sesión.
#   DEFAULT_PASSWORD_STAFF      -> empleados (rol "staff")
#   DEFAULT_PASSWORD_VISITANTE  -> clientes (rol "visitante")
DEFAULT_PASSWORD_STAFF=ElHigueron.Staff24
DEFAULT_PASSWORD_VISITANTE=ElHigueron.Visita24
